# Face-Auth — variables de entorno (copiar a `.env` y ajustar)

# Django
SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Puertos host (Docker Compose / run_devserver.py / Vite)
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Puerto publicado de Postgres en el host (Compose mapea POSTGRES_PORT→5432 del contenedor).
# Default 5433 para no chocar con un Postgres nativo en :5432.
POSTGRES_PORT=5433

# Hosts que Vite acepta en el header Host (dev/preview detrás de dominio/proxy).
# Lista separada por comas, o `true` / `all` para permitir cualquiera.
# Ej. producción: FRONTEND_ALLOWED_HOSTS=sso.chatuzpark.store
# FRONTEND_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (Postgres + pgvector)
# Híbrido (apps en host + `docker compose up -d db`):
#   POSTGRES_HOST=localhost y POSTGRES_PORT = puerto publicado arriba.
# Backend dentro de Compose: usa DATABASE_URL interno (db:5432); ignora este puerto.
POSTGRES_USER=faceauth
POSTGRES_PASSWORD=faceauth
POSTGRES_DB=faceauth
POSTGRES_HOST=localhost

# Opcional: URL completa. Si se define, tiene prioridad sobre POSTGRES_* anteriores.
# DATABASE_URL=postgres://faceauth:faceauth@localhost:5433/faceauth

# CORS — orígenes del frontend permitidos (lista exacta).
# Si cambias FRONTEND_PORT o accedes por IP de red (ej. 192.168.x.x), agrégalos aquí.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Umbrales por defecto del pipeline biométrico (sobreescritos por Application)
LIVENESS_THRESHOLD_DEFAULT=0.85
MATCH_THRESHOLD_DEFAULT=0.42

# Rate limit login/registro (app_id + IP). En multi-worker / prod: definir REDIS_URL.
BIOMETRIC_AUTH_THROTTLE=30/min
# REDIS_URL=redis://localhost:6379/0

# OTP — códigos de un solo uso (ver docs/OTP_VALIDATION.md)
OTP_TTL_SECONDS=300
OTP_ISSUE_MAX=3
OTP_ISSUE_WINDOW_SECONDS=300
OTP_VERIFY_MAX_ATTEMPTS=5
# OTP_PEPPER=  # default: SECRET_KEY
# Cortesía por IP (el tope 3/5 min por usuario vive en el servicio).
# OTP_IP_THROTTLE=10/min
# OTP_VERIFY_IP_THROTTLE=20/min

# Email. En `config.settings.dev` el default es console (imprime el código en logs).
# El backend de Compose NO debe usar EMAIL_HOST=localhost (localhost es el contenedor).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#
# STARTTLS (la mayoría: Gmail, SES, Mailgun, puerto 587):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
#
# SSL implícito (puerto 465). No combines TLS+465:
# EMAIL_PORT=465
# EMAIL_USE_TLS=False
# EMAIL_USE_SSL=True
#
# EMAIL_TIMEOUT=30
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# FROM debe ser un remitente aceptado por el proveedor (suele ser el mismo usuario SMTP).
DEFAULT_FROM_EMAIL=Face-Auth <noreply@localhost>

# Frontend (Vite) — URL completa del API vista desde el navegador.
# No se reconstruye en Compose: si cambias host o puerto, edita esta variable.
# Ej. LAN: VITE_API_BASE_URL=http://192.168.1.10:8000
VITE_API_BASE_URL=http://localhost:8000
