# Face-Auth — variables de entorno (copiar a `.env` y ajustar)

# Django
SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Puertos (Docker Compose, run_devserver.py, Vite)
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Base de datos (Postgres + pgvector)
# Local con compose: host localhost, puerto 5433 (evita conflicto con Postgres nativo en :5432)
# Dentro de la red Docker: POSTGRES_HOST=db y POSTGRES_PORT=5432
POSTGRES_USER=faceauth
POSTGRES_PASSWORD=faceauth
POSTGRES_DB=faceauth
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Opcional: URL completa. Si se define, tiene prioridad sobre POSTGRES_* anteriores.
# DATABASE_URL=postgres://faceauth:faceauth@localhost:5433/faceauth

# CORS — orígenes del frontend permitidos.
# Si cambias FRONTEND_PORT, actualiza estos orígenes (en Docker Compose se derivan solos).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Umbrales por defecto del pipeline biométrico (sobreescritos por Application)
LIVENESS_THRESHOLD_DEFAULT=0.85
MATCH_THRESHOLD_DEFAULT=0.42

# Rate limit login/registro (app_id + IP). En multi-worker / prod: definir REDIS_URL.
BIOMETRIC_AUTH_THROTTLE=30/min
# REDIS_URL=redis://localhost:6379/0

# Frontend (Vite) — debe apuntar al BACKEND_PORT expuesto al host
VITE_API_BASE_URL=http://localhost:8000
